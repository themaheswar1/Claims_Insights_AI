cat > .ebextensions/nginx-proxy-fix.config << 'EOF'
container_commands:
  01_create_upstream_conf:
    command: |
      mkdir -p /etc/nginx/conf.d
      cat > /etc/nginx/conf.d/elasticbeanstalk-nginx-docker-upstream.conf << 'INNEREOF'
      upstream docker {
          server 127.0.0.1:8501;
          keepalive 256;
      }
      INNEREOF
  02_restart_nginx:
    command: "systemctl restart nginx || systemctl start nginx"
EOF